<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Cleaner Lite" Width="940" Height="820" MinWidth="720" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#09070F" Foreground="#F4EFFA"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#12101B"/>
    <SolidColorBrush x:Key="BorderColor" Color="#38284E"/>
    <SolidColorBrush x:Key="Secondary" Color="#BDB1CE"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="20,11"/><Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Foreground" Value="#F4EFFA"/><Setter Property="Background" Value="#251B37"/>
      <Setter Property="BorderBrush" Value="#6F4A99"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="42"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Face" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <Grid><Border CornerRadius="8" BorderThickness="0,1,0,0" BorderBrush="#40D5B7FF"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#3C2858"/><Setter TargetName="Face" Property="BorderBrush" Value="#BE8AFF"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="White"/><Setter TargetName="Face" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#181120"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F4EFFA"/><Setter Property="Margin" Value="0,0,24,8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="24"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#0D0A14"/><Setter Property="Foreground" Value="#F4EFFA"/>
      <Setter Property="RowBackground" Value="#12101B"/><Setter Property="AlternatingRowBackground" Value="#1D172B"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/><Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="38"/>
      <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#251B37"/><Setter Property="Foreground" Value="#D5C5E5"/>
        <Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/>
      </Style></Setter.Value></Setter>
      <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,7"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#49305F"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
      </Style></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,24">
      <TextBlock Text="ROBLOX / CLEANER LITE" FontSize="12" Foreground="#B785FA" HorizontalAlignment="Center" Margin="0,0,0,8"/>
      <TextBlock Text="A little cleanup. A fresh start." FontSize="28" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock Text="Portable for Windows · Preview first · No administrator required" Foreground="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="SELECTED FOR CLEANUP" FontSize="12" Foreground="{StaticResource Secondary}"/>
              <TextBlock x:Name="Total" Text="0 bytes" FontSize="36" FontWeight="SemiBold" Margin="0,4,0,4"/>
              <TextBlock x:Name="FileCount" Text="Scan to find eligible files" Foreground="{StaticResource Secondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="280" Margin="24,0,0,0">
              <TextBlock Text="YOUR WORK STAYS PUT" FontSize="12" Foreground="#B785FA"/>
              <TextBlock Text="Installations, settings, saved places and recovery folders are excluded." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Secondary}"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Choose what to clean" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <WrapPanel>
              <CheckBox x:Name="Cache" Content="Asset caches" IsChecked="True" AutomationProperties.Name="Include asset caches"/>
              <CheckBox x:Name="DeepCache" Content="Deep cache" IsChecked="False" AutomationProperties.Name="Include deeper asset and shader caches" ToolTip="Asset payload folders and recognized shader cache files. Roblox may redownload assets or rebuild shaders."/>
              <CheckBox x:Name="Logs" Content="Older logs" IsChecked="True" AutomationProperties.Name="Include Roblox log files"/>
              <CheckBox x:Name="Crashes" Content="Crash dumps" IsChecked="False" AutomationProperties.Name="Include Roblox crash dumps"/>
            </WrapPanel>
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Text="Age filter" VerticalAlignment="Center" Margin="0,0,16,0"/>
              <ComboBox x:Name="Retention" Grid.Column="1" SelectedIndex="0" Padding="10,6" MaxWidth="330" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="Keep files newer than selected age">
                <ComboBoxItem Content="Keep newest 1 day"/><ComboBoxItem Content="Keep newest 7 days"/>
                <ComboBoxItem Content="Keep newest 30 days"/><ComboBoxItem Content="Include all ages"/>
              </ComboBox>
            </Grid>
            <TextBlock Text="Cached assets may download again. Logs and dumps can help diagnose problems." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Secondary}" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
        <DataGrid x:Name="Summary" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" Height="240" Margin="0,0,0,16" AutomationProperties.Name="Recognized cleanup folders">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Recognized folder" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="Files" Binding="{Binding Count}" Width="75"/>
            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110"/>
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="105"/>
          </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Margin="0,0,0,8">
          <Button x:Name="Scan" Content="_Scan" Background="#573284" AutomationProperties.Name="Scan Roblox folders"/>
          <Button x:Name="DeepScan" Content="_Deep scan" ToolTip="Scans all ages with asset payload and shader caches included. Review and confirm before deletion."/>
          <Button x:Name="Preview" Content="_Preview files" IsEnabled="False"/>
          <Button x:Name="Clean" Content="_Clean selected" IsEnabled="False"/>
          <Button x:Name="Cancel" Content="Ca_ncel" IsEnabled="False"/>
          <Button x:Name="Export" Content="_Export report" IsEnabled="False" Margin="0,8,0,0"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <ProgressBar x:Name="Progress" Height="4" Foreground="#A970FF" Background="#251B37" BorderThickness="0" Margin="0,0,0,12"/>
      <TextBlock x:Name="Status" Text="Ready. Click Scan to preview eligible Roblox files." TextWrapping="Wrap"/>
      <TextBlock x:Name="ProcessState" Text="Checking Roblox processes..." TextWrapping="Wrap" Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,6,0,0"/>
      <TextBlock Text="v0.2.0 · Local cleanup only" TextAlignment="Center" Foreground="{StaticResource Secondary}" FontSize="11" Margin="0,12,0,0"/>
    </StackPanel>
  </Grid>
</Window>
